# HiKARii Environment Configuration

# Transactional Email Notification Service (Resend)
# Add your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
EMAIL_API_KEY=re_your_api_key_here

# Destination email for client project inquiries (default: contact@hikarii.studio)
CONTACT_EMAIL=contact@hikarii.studio

# Sender address (e.g., HiKARii Inquiries <inquiries@hikarii.studio> or onboarding@resend.dev)
EMAIL_FROM=HiKARii Inquiries <onboarding@resend.dev>
